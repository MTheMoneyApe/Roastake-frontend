# Optional WalletConnect Cloud Project ID (public client identifier, never a secret).
# Leave unset to use browser-injected EVM wallets cleanly without WalletConnect QR.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional read-only local Persistent Market History Indexer base URL (no secrets/credentials).
VITE_PERPS_HISTORY_API_URL=http://127.0.0.1:8787
